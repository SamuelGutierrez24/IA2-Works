# Archivo de configuración para entorno de desarrollo
ENVIRONMENT=development

# URL de la base de datos (para producción podrías cambiar esto)
DATABASE_URL=sqlite:///./data/tasks.db

# Puerto de la aplicación
PORT=8000

# Configuración de uvicorn
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_RELOAD=true

# Nombre de la aplicación
APP_NAME=QuickTask API
APP_VERSION=1.0.0
